page { background: #0D1117; }

.page {
  min-height: 100vh;
  background: #0D1117;
  padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* 总览卡片 */
.summary-card {
  background: #161B22;
  border-radius: 16rpx;
  border: 1rpx solid #21262D;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 0;
  margin-bottom: 40rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #F1F5F9;
  font-variant-numeric: tabular-nums;
}

.summary-desc {
  font-size: 20rpx;
  color: #4A5568;
  letter-spacing: 2rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.summary-divider {
  width: 1rpx;
  height: 52rpx;
  background: #21262D;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; color: #2D3748; font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; }
.empty-sub  { font-size: 24rpx; color: #21262D; }

/* 列表标题 */
.section-title {
  font-size: 20rpx;
  color: #4A5568;
  letter-spacing: 3rpx;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

/* 记录列表 */
.record-list { display: flex; flex-direction: column; gap: 16rpx; }

.record-card {
  background: #161B22;
  border-radius: 16rpx;
  border: 1rpx solid #21262D;
  padding: 28rpx 32rpx;
}

.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #F1F5F9;
  display: block;
}

.record-time {
  font-size: 22rpx;
  color: #4A5568;
  display: block;
  margin-top: 4rpx;
}

.record-badge {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.badge-complete {
  background: rgba(46,213,115,0.12);
  color: #2ED573;
}

.badge-partial {
  background: rgba(255,165,2,0.12);
  color: #FFA502;
}

.record-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.r-stat { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.r-stat-num   { font-size: 32rpx; font-weight: 800; color: #F1F5F9; font-variant-numeric: tabular-nums; }
.r-stat-label { font-size: 18rpx; color: #4A5568; letter-spacing: 1rpx; font-weight: 600; text-transform: uppercase; }

/* 进度条 */
.progress-bar-bg {
  height: 6rpx;
  background: #21262D;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #FF4757;
  border-radius: 3rpx;
}

/* 清空按钮 */
.clear-btn {
  margin-top: 48rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #2D3748;
  border: 1rpx dashed #21262D;
  border-radius: 12rpx;
  letter-spacing: 2rpx;
}

.clear-btn:active { color: #FF4757; border-color: rgba(255,71,87,0.3); }
