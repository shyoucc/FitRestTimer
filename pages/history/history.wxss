page { background: #F5F6FA; }

.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* 总览卡片 */
.summary-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 0;
  margin-bottom: 40rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #111827;
  font-variant-numeric: tabular-nums;
}

.summary-desc {
  font-size: 22rpx;
  color: #9CA3AF;
}

.summary-divider {
  width: 1rpx;
  height: 52rpx;
  background: #F3F4F6;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; color: #C4C9D4; font-weight: 600; }
.empty-sub  { font-size: 24rpx; color: #DDE1EC; }

/* 列表标题 */
.section-title {
  font-size: 22rpx;
  color: #9CA3AF;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

/* 记录列表 */
.record-list { display: flex; flex-direction: column; gap: 16rpx; }

.record-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  padding: 28rpx 32rpx;
}

.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
}

.record-time {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  margin-top: 4rpx;
}

.record-badge {
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-complete {
  background: #D1FAE5;
  color: #10B981;
}

.badge-partial {
  background: #FEF3C7;
  color: #F59E0B;
}

.record-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.r-stat { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.r-stat-num   { font-size: 32rpx; font-weight: 700; color: #111827; font-variant-numeric: tabular-nums; }
.r-stat-label { font-size: 20rpx; color: #9CA3AF; }

/* 进度条 */
.progress-bar-bg {
  height: 6rpx;
  background: #F3F4F6;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #F97066;
  border-radius: 3rpx;
}

/* 清空按钮 */
.clear-btn {
  margin-top: 48rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #C4C9D4;
  border: 1rpx dashed #E5E7EB;
  border-radius: 16rpx;
}

.clear-btn:active { color: #F97066; border-color: #FECACA; }
