/* ══ 基础 ════════════════════════════════════════════════ */
page { background: #0D1117; }

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0D1117;
  box-sizing: border-box;
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ══ 顶部导航栏 ══════════════════════════════════════════ */
.bar {
  flex-shrink: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
}

.bar-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: #F1F5F9;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.spacer { flex: 1; }

.dots {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.dot {
  width: 16rpx; height: 16rpx;
  border-radius: 4rpx;
  background: #2D3748;
}
.dot-done  { background: #2ED573; }
.dot-work  { background: #2ED573; box-shadow: 0 0 0 4rpx rgba(46,213,115,.22); }
.dot-rest  { background: #FF4757; box-shadow: 0 0 0 4rpx rgba(255,71,87,.22); }
.dot-pause { background: #4A5568; }

.icon-btn {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.07);
}
.icon-hist {
  font-size: 30rpx;
  color: #64748B;
  letter-spacing: -2rpx;
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-toggle {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.07);
}
.voice-toggle:active { background: rgba(255,255,255,0.12); }
.voice-on { background: rgba(255,71,87,0.15); }

.voice-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ══ 空闲：中心区 ════════════════════════════════════════ */
.idle-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
  min-height: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}

/* 大字预览 */
.preview-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.preview-time {
  font-size: 88rpx;
  font-weight: 800;
  color: #F1F5F9;
  line-height: 1;
  letter-spacing: -3rpx;
  font-variant-numeric: tabular-nums;
}

.preview-label {
  font-size: 20rpx;
  color: #4A5568;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  font-weight: 600;
}

/* 设置卡片 */
.card {
  background: #161B22;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #21262D;
}

.card-row {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.card-row-h {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card-divider {
  height: 1rpx;
  background: #21262D;
  margin: 0 28rpx;
}

.card-label {
  font-size: 20rpx;
  color: #64748B;
  letter-spacing: 2rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.voice-label-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.voice-sub {
  font-size: 20rpx;
  color: #4A5568;
}

/* 时长选择 chips */
.chips-scroll { overflow: hidden; }
.chips { display: inline-flex; gap: 12rpx; }

.chip {
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
  background: #21262D;
  white-space: nowrap;
}
.chip-on {
  background: rgba(255,71,87,0.15);
  color: #FF4757;
  font-weight: 700;
}

/* 组数步进器 */
.stepper { display: flex; align-items: center; gap: 24rpx; }

.step-btn {
  width: 64rpx; height: 64rpx;
  border-radius: 12rpx;
  background: #21262D;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  color: #94A3B8;
}
.step-btn:active { background: #2D3748; }

.step-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #F1F5F9;
  min-width: 56rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

/* ══ 训练中 ══════════════════════════════════════════════ */
.work-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  min-height: 0;
}

.set-index {
  font-size: 56rpx;
  font-weight: 800;
  color: #F1F5F9;
  letter-spacing: 2rpx;
}

.set-total {
  font-size: 24rpx;
  color: #4A5568;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.elapsed-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 48rpx;
  padding: 28rpx 56rpx;
  background: #161B22;
  border-radius: 16rpx;
  border: 1rpx solid #21262D;
}

.elapsed-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #2ED573;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.elapsed-unit {
  font-size: 22rpx;
  color: #4A5568;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.work-hint {
  font-size: 22rpx;
  color: #4A5568;
  margin-top: 32rpx;
  letter-spacing: 1rpx;
}

/* ══ 休息 / 暂停：圆环 ══════════════════════════════════ */
.ring-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  min-height: 0;
}

.ring-wrap {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  flex-shrink: 0;
}

.ring-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ring-inner {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.ring-time {
  font-size: 100rpx;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.ring-label {
  font-size: 20rpx;
  color: #4A5568;
  letter-spacing: 4rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.ring-note {
  font-size: 24rpx;
  color: #4A5568;
  letter-spacing: 1rpx;
}

/* ══ 完成界面 ════════════════════════════════════════════ */
.done-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 0;
}

.done-badge {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: rgba(46,213,115,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #2ED573;
  margin-bottom: 8rpx;
}

.done-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #F1F5F9;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.done-sub {
  font-size: 24rpx;
  color: #4A5568;
  letter-spacing: 1rpx;
}

.done-card {
  display: flex;
  align-items: center;
  background: #161B22;
  border-radius: 16rpx;
  border: 1rpx solid #21262D;
  padding: 32rpx 0;
  width: 100%;
  margin-top: 16rpx;
}

.done-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ds-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #F1F5F9;
  font-variant-numeric: tabular-nums;
}

.ds-key {
  font-size: 18rpx;
  color: #4A5568;
  letter-spacing: 2rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.done-sep {
  width: 1rpx;
  height: 48rpx;
  background: #21262D;
}

/* ══ 底部按钮区 ══════════════════════════════════════════ */
.footer {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

/* 主按钮 */
.btn-primary {
  flex: 1;
  height: 104rpx;
  border-radius: 16rpx;
  background: #FF4757;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}
.btn-primary:active { opacity: 0.85; transform: scale(0.985); }

.btn-green {
  background: #2ED573;
  color: #0D1117;
}

.btn-full { width: 100%; flex: none; }

/* 开始训练 */
.btn-start {
  flex: none;
  width: auto;
  height: 92rpx !important;
  padding: 0 72rpx;
  border-radius: 16rpx !important;
  font-size: 28rpx !important;
  font-weight: 800;
  letter-spacing: 3rpx;
  align-self: center;
}

/* 次按钮 */
.btn-secondary {
  flex: 1;
  height: 104rpx;
  border-radius: 16rpx;
  background: rgba(255,71,87,0.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF4757;
  letter-spacing: 2rpx;
}
.btn-secondary:active { opacity: 0.8; }

/* 描边按钮 */
.btn-outline {
  flex: 1;
  height: 104rpx;
  border-radius: 16rpx;
  background: transparent;
  border: 1.5rpx solid #2D3748;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #64748B;
  letter-spacing: 2rpx;
}
.btn-outline:active { background: #161B22; }

.btn-outline-red {
  color: #FF4757;
  border-color: rgba(255,71,87,0.3);
}

/* 纯文字按钮 */
.btn-text {
  height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
  color: #2D3748;
  letter-spacing: 1rpx;
}
